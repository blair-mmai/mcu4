# One-time manual setup — run with /function virtues:npc/tag_all_magincia_npcs
# after placing/naming Magincia's NPCs (NBT_Creator/NBT_world2, during
# Magincia.nbt authoring). Magincia is repurposed as a ruined, Humility-themed
# town (not the U5 "New Magincia" concept) — see [[project_state]]. Tags each
# named villager npc_<name> for trade-completion advancement matching and
# general re-identification if the town has to be rebuilt from scratch.

tag @e[type=minecraft:villager,name="Faultless",limit=1] add npc_faultless
tag @e[type=minecraft:villager,name="Heywood",limit=1] add npc_heywood
tag @e[type=minecraft:villager,name="Katrina",limit=1] add npc_katrina
tag @e[type=minecraft:villager,name="Nate the Snake",limit=1] add npc_nate_the_snake
tag @e[type=minecraft:villager,name="Virtuebane",limit=1] add npc_virtuebane
