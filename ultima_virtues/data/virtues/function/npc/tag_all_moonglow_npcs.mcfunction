# One-time manual setup — run with /function virtues:npc/tag_all_moonglow_npcs
# after placing/naming Moonglow's NPCs (NBT_Creator/NBT_world2, during
# Moonglow.nbt authoring). Tags each named villager npc_<name> for
# trade-completion advancement matching and general re-identification if the
# town has to be rebuilt from scratch.
#
# Patric's tag is snake_case of his full name (has spaces) — npc_patric_the_humble_shepherd.

tag @e[type=minecraft:villager,name="Browning",limit=1] add npc_browning
tag @e[type=minecraft:villager,name="Calabrini",limit=1] add npc_calabrini
tag @e[type=minecraft:villager,name="Christen",limit=1] add npc_christen
tag @e[type=minecraft:villager,name="Cromwell",limit=1] add npc_cromwell
tag @e[type=minecraft:villager,name="Mariah",limit=1] add npc_mariah
tag @e[type=minecraft:villager,name="Patric the Humble Shepherd",limit=1] add npc_patric_the_humble_shepherd
tag @e[type=minecraft:villager,name="Rebelias",limit=1] add npc_rebelias
tag @e[type=minecraft:villager,name="Scatu",limit=1] add npc_scatu
tag @e[type=minecraft:villager,name="Shakespeare",limit=1] add npc_shakespeare
tag @e[type=minecraft:villager,name="Shazom",limit=1] add npc_shazom
tag @e[type=minecraft:villager,name="William",limit=1] add npc_william
