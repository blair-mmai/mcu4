# One-time manual setup — run with /function virtues:npc/tag_all_lycaeum_npcs
# after placing/naming the Lycaeum's NPCs (NBT_Creator/NBT_world2, during
# Lycaeum.nbt authoring). The Lycaeum doubles as both the library and
# Castle Britannia stand-in. Tags each named villager npc_<name> for
# trade-completion advancement matching and general re-identification if the
# location has to be rebuilt from scratch.

tag @e[type=minecraft:villager,name="Nearly A Corpse",limit=1] add npc_nearly_a_corpse
tag @e[type=minecraft:villager,name="Beth Frasier",limit=1] add npc_beth_frasier
tag @e[type=minecraft:villager,name="Estro",limit=1] add npc_estro
tag @e[type=minecraft:villager,name="Father Antos",limit=1] add npc_father_antos
tag @e[type=minecraft:villager,name="Lord Terence",limit=1] add npc_lord_terence
tag @e[type=minecraft:villager,name="Nigel",limit=1] add npc_nigel
tag @e[type=minecraft:villager,name="Robert Frasier",limit=1] add npc_robert_frasier
tag @e[type=minecraft:villager,name="Scatuu",limit=1] add npc_scatuu
tag @e[type=minecraft:villager,name="Shylock the Meek",limit=1] add npc_shylock_the_meek
tag @e[type=minecraft:villager,name="Tymus",limit=1] add npc_tymus
tag @e[type=minecraft:villager,name="Starfire",limit=1] add npc_starfire
