execute if entity @s[name="Welcomer"] if data entity @s Offers if data entity @s VillagerData{level:3} run data modify entity @s Offers.Recipes set value [{buy:{id:"minecraft:paper",count:1},sell:{id:"minecraft:book",count:1},maxUses:999999,xp:10},{buy:{id:"minecraft:sand",count:3},sell:{id:"minecraft:glass_bottle",count:1},maxUses:999999,xp:30},{buy:{id:"minecraft:book",count:1},sell:{id:"minecraft:written_book",count:1,components:{"minecraft:written_book_content":{title:"On POTIONS",author:"Celest",pages:['About POTIONS:\nEvery VIRTUE has always had a MOONGATE and for each a TOWN was built nearby. \nWe use the power of the moongates and redstone to TELEPORT between towns.','Potions of note:\nB1. Return Potion (returns ye to yer stone circle).\nB2. Compassion Potion\nB3. Potion of Sacrifice (made partly from wet bread - yuck...)\nB4. Potion of Valor (the recipe was lost but it is believed it needs a ton of IRON).\netc.','The RETURN POTION is made from the simplest ingredients -- dirt, wheat seeds, and 1 redstone dust, mixed into a glass bottle.\nThe trick, really, is to find a good source of redstone dust... And, some CLERICS are said to hold GREAT amounts of it!']}}},maxUses:999999,xp:80}]
execute if entity @s[name="Welcomer"] if data entity @s Offers if data entity @s VillagerData{level:4} run data modify entity @s Offers.Recipes set value [{buy:{id:"minecraft:paper",count:1},sell:{id:"minecraft:book",count:1},maxUses:999999,xp:10},{buy:{id:"minecraft:sand",count:3},sell:{id:"minecraft:glass_bottle",count:1},maxUses:999999,xp:30},{buy:{id:"minecraft:book",count:1},sell:{id:"minecraft:written_book",count:1,components:{"minecraft:written_book_content":{title:"On POTIONS",author:"Celest",pages:['About POTIONS:\nEvery VIRTUE has always had a MOONGATE and for each a TOWN was built nearby. \nWe use the power of the moongates and redstone to TELEPORT between towns.','Potions of note:\nB1. Return Potion (returns ye to yer stone circle).\nB2. Compassion Potion\nB3. Potion of Sacrifice (made partly from wet bread - yuck...)\nB4. Potion of Valor (the recipe was lost but it is believed it needs a ton of IRON).\netc.','The RETURN POTION is made from the simplest ingredients -- dirt, wheat seeds, and 1 redstone dust, mixed into a glass bottle.\nThe trick, really, is to find a good source of redstone dust... And, some CLERICS are said to hold GREAT amounts of it!']}}},maxUses:999999,xp:80},{buy:{id:"minecraft:potion",count:1,components:{"minecraft:potion_contents":{potion:"minecraft:water"}}},sell:{id:"minecraft:written_book",count:1,components:{"minecraft:written_book_content":{title:"On CRAFTING POTIONS",author:"Welcomer",pages:['Crafting Potions:\nA 2x2 crafting grid is sufficient for most simple potions. \nSimple potions include: \nA. Health potions: Vegans are the best at making these smoothies!','B. Teleportation: Can move you widely through These Lands via the moongates\' power.  Usually the magic ingredient is SYMBOLIC.\nC. Elevation: To help you on your path towards Enlightment.  Seek more books on this topic.','TELEPORT RECIPES:\nB1. Return Potion:\n- blend well: 1 plain dirt, 1 wheat seed,  and 1 redstone dust. And shake - dont stir - into a glass bottle. ','B2. Compassion Potion: \n- blend well: brown mushroom and redstone dust. Sprinkle more redstone on top, and pour into a glass bottle. \nB3. Potion of Sacrifice:\n- blend: bread, glistering_melon_slice, and 1 redstone dusts into a water bottle.   Drinking wet bread makes you feel the sacrifice.']}}},maxUses:999999,xp:10}]
